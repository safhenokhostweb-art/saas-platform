#!/bin/sh
# PHASE 5 — PRE-COMMIT DRIFT CHECK
# Lightweight validation before each commit.
# Detects: duplicate creation, shared ownership violations, namespace conflicts.

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 0

DRIFT_SCRIPT="$REPO_ROOT/scripts/drift-detect.php"

if [ ! -f "$DRIFT_SCRIPT" ]; then
    exit 0
fi

# Only run on PHP files and Blade files
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(php|blade\.php)$' || true)

if [ -z "$CHANGED_FILES" ]; then
    exit 0
fi

# Run quick drift check (only blade and controller checks, no report)
php "$DRIFT_SCRIPT" --check-blade --check-controllers --check-ownership 2>&1
RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "❌ PRE-COMMIT DRIFT CHECK FAILED"
    echo "   High-severity drift violations detected."
    echo "   To bypass (not recommended): git commit --no-verify"
    echo "   To add exception: php scripts/drift-detect.php --add-exception <file> <reason>"
    exit 1
fi

exit 0
