{
    "name": "saas-platform/core-utils",
    "description": "Shared Core Utilities for SaaS Platform modules",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SaaSPlatform\\CoreUtils\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SaaSPlatform\\CoreUtils\\Providers\\CoreUtilsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}