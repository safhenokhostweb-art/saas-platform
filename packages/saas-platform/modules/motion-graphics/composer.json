{
    "name": "saas-platform/modules-motion-graphics",
    "description": "Standalone provider-neutral motion asset management package",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.50"
    },
    "require-dev": {
        "orchestra/testbench": "^8.37",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SaaSPlatform\\Modules\\MotionGraphics\u005C": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SaaSPlatform\\Modules\\MotionGraphics\\Tests\u005C": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
