{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AI_PROVIDER_PROPOSAL.schema.json",
  "title": "AI Asset Editing Provider Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "proposal_id",
    "request_id",
    "metadata_changes",
    "ai_metadata"
  ],
  "properties": {
    "status": {
      "enum": [
        "generated",
        "failed"
      ]
    },
    "proposal_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "request_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "preview": {
      "$ref": "#/$defs/fileDescriptor"
    },
    "generated_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/generatedFile"
      }
    },
    "metadata_changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operation",
          "value",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/(editable|theme|display)(/[A-Za-z0-9_.-]+)+$"
          },
          "operation": {
            "enum": [
              "add",
              "replace",
              "remove"
            ]
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "ai_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "generated_at",
        "warnings"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider_request_id": {
          "type": "string",
          "maxLength": 255
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_units": {
              "type": "integer",
              "minimum": 0
            },
            "output_units": {
              "type": "integer",
              "minimum": 0
            },
            "estimated_cost": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "generated"
          }
        }
      },
      "then": {
        "required": [
          "preview",
          "generated_files"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "media_type",
        "sha256"
      ],
      "properties": {
        "file_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "media_type": {
          "enum": [
            "image/svg+xml",
            "image/png",
            "image/webp",
            "application/json"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bounded_content": {
          "type": "string",
          "maxLength": 2000000
        }
      }
    },
    "generatedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "relative_path",
        "media_type",
        "sha256",
        "proposed_content"
      ],
      "properties": {
        "file_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "relative_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "media_type": {
          "enum": [
            "image/svg+xml",
            "application/json",
            "text/css",
            "text/plain"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proposed_content": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 2000000
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        }
      }
    }
  }
}
