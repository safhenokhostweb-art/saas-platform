{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AI_PROVIDER_REQUEST.schema.json",
  "title": "AI Asset Editing Provider Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "customer_scope",
    "asset_id",
    "asset_version",
    "asset_files",
    "metadata",
    "brand_theme",
    "logo",
    "instruction",
    "prompt",
    "constraints"
  ],
  "properties": {
    "request_id": { "$ref": "#/$defs/opaqueId" },
    "customer_scope": { "$ref": "#/$defs/opaqueId" },
    "asset_id": { "type": "string", "minLength": 3, "maxLength": 255 },
    "asset_version": { "type": "string", "pattern": "^v?[1-9][0-9]*$" },
    "asset_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/inputFile" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_type", "engine", "editable_properties"],
      "properties": {
        "asset_type": { "enum": ["motion", "icon", "object", "visual-asset"] },
        "engine": { "type": "string", "minLength": 1, "maxLength": 64 },
        "editable_properties": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
        },
        "safe_context": { "type": "object", "additionalProperties": true }
      }
    },
    "brand_theme": { "$ref": "BRAND_THEME.schema.json" },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sanitized_ref", "media_type", "sha256"],
      "properties": {
        "sanitized_ref": { "$ref": "#/$defs/opaqueId" },
        "media_type": { "enum": ["image/svg+xml", "image/png", "image/webp"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bounded_content": { "type": "string", "maxLength": 2000000 }
      }
    },
    "instruction": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 16000 },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_master", "preserve_structure", "preserve_accessibility", "allow_external_dependencies", "allowed_changes"],
      "properties": {
        "preserve_master": { "const": true },
        "preserve_structure": { "const": true },
        "preserve_accessibility": { "const": true },
        "allow_external_dependencies": { "const": false },
        "allowed_changes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["recolor", "style", "theme-variant", "composition", "industry-variation", "logo-placement"] }
        }
      }
    }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "inputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "role", "media_type", "sha256", "sanitized_content"],
      "properties": {
        "file_id": { "$ref": "#/$defs/opaqueId" },
        "role": { "enum": ["primary", "preview", "supporting"] },
        "media_type": { "enum": ["image/svg+xml", "application/json", "text/css", "text/plain"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sanitized_content": {
          "oneOf": [
            { "type": "string", "maxLength": 2000000 },
            { "type": "object", "additionalProperties": true }
          ]
        }
      }
    }
  }
}
