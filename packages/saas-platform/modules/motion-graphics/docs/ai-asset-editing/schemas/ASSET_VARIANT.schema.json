{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ASSET_VARIANT.schema.json",
  "title": "Customer Asset Variant Version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "variant_id",
    "source_asset",
    "source_version",
    "source_sha256",
    "customer_id",
    "theme",
    "ai_provider",
    "prompt_history",
    "proposal_id",
    "proposal_sha256",
    "created_by",
    "created_at",
    "version",
    "status",
    "artifacts"
  ],
  "properties": {
    "variant_id": { "$ref": "#/$defs/opaqueId" },
    "source_asset": { "type": "string", "minLength": 3, "maxLength": 255 },
    "source_version": { "type": "string", "pattern": "^v?[1-9][0-9]*$" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "customer_id": { "$ref": "#/$defs/opaqueId" },
    "theme": { "$ref": "BRAND_THEME.schema.json" },
    "ai_provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "prompt_history": { "$ref": "#/$defs/opaqueId" },
    "proposal_id": { "$ref": "#/$defs/opaqueId" },
    "proposal_sha256": { "$ref": "#/$defs/sha256" },
    "parent_variant_version": { "type": ["integer", "null"], "minimum": 1 },
    "created_by": { "$ref": "#/$defs/opaqueId" },
    "created_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["approved_unpublished", "published", "retired"] },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "media_type", "sha256", "size_bytes"],
        "properties": {
          "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\./)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$" },
          "media_type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
