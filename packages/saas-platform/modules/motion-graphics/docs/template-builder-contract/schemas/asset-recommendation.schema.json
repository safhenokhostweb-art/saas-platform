{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "motion-graphics/template-builder/asset-recommendation/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "asset_id", "reason", "placement", "size", "theme_variant", "responsive_behavior"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "asset_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["section", "position", "alignment", "priority"],
      "properties": {
        "section": { "enum": ["hero", "about", "services", "features", "products", "portfolio", "testimonials", "team", "contact", "cta", "footer"] },
        "position": { "enum": ["background", "leading", "trailing", "inline", "full-width", "card-media"] },
        "alignment": { "enum": ["start", "center", "end", "inline-start", "inline-end"] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "size": { "enum": ["small", "medium", "large", "fluid"] },
    "theme_variant": { "enum": ["master-theme", "brand-proposal", "compiled-approved-variant"] },
    "responsive_behavior": {
      "type": "object", "additionalProperties": false,
      "required": ["desktop", "tablet", "mobile", "reduced_motion"],
      "properties": {
        "desktop": { "enum": ["show", "hide", "static-preview"] },
        "tablet": { "enum": ["show", "hide", "static-preview"] },
        "mobile": { "enum": ["show", "hide", "static-preview"] },
        "reduced_motion": { "enum": ["static-preview", "disable", "simplified"] }
      }
    }
  }
}
