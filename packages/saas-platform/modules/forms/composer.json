{
    "name": "saas-platform/modules-forms",
    "description": "Shared Forms Module for SaaS Platform",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "saas-platform/core-utils": "@dev"
    },
    "autoload": {
        "psr-4": {
            "SaaSPlatform\\Modules\\Forms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SaaSPlatform\\Modules\\Forms\\Providers\\FormsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}