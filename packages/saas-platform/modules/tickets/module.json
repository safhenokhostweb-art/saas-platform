{
    "name": "Tickets Module",
    "module_slug": "tickets",
    "version": "1.1.0",
    "schema_version": "1",
    "type": "core",
    "description": "Canonical support ticket module for the SaaS Platform ecosystem. Provides full ticket lifecycle, status machine, SLA tracking, portal isolation, and tenant segregation.",
    "namespace": "SaaSPlatform\\Modules\\Tickets",
    "provider": "SaaSPlatform\\Modules\\Tickets\\Providers\\TicketsServiceProvider",
    "compatibility": {
        "php": "^8.1",
        "laravel": "^10.0",
        "saas-platform": ">=1.0.0"
    },
    "update_type": "minor",
    "dependencies": {
        "packages": [],
        "modules": []
    },
    "publish_tags": [
        "tickets-config",
        "tickets-views",
        "tickets-migrations",
        "tickets-manifest",
        "tickets-assets"
    ],
    "config": {
        "ticket_statuses": ["open", "in_progress", "closed"],
        "ticket_priorities": ["low", "normal", "high"],
        "pagination": 20,
        "sla_enabled": false
    },
    "license": "MIT",
    "authors": [
        {
            "name": "SaaS Platform Team"
        }
    ]
}
