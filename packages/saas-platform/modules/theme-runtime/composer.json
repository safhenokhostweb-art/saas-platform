{
    "name": "saas-platform/modules-theme-runtime",
    "description": "Canonical Theme block rendering/registry/CSS authority shared by the SaaS Builder preview and customer-site tenant runtime",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SaaSPlatform\\ThemeRuntime\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SaaSPlatform\\ThemeRuntime\\Providers\\ThemeRuntimeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
