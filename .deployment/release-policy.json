{
  "schema_version": 1,
  "production_branch": "main",
  "remote": "origin",
  "allowed_release_paths": [
    ".deployment/**",
    "docs/**",
    "tests/**",
    "app/**",
    "packages/**",
    "resources/**",
    "routes/**",
    "database/**",
    "scripts/**",
    "AGENTS.md",
    "config/resource_governance.php",
    ".gitignore",
    "composer.json",
    "composer.lock",
    "package.json",
    "package-lock.json",
    "phpunit.xml",
    "DEPLOY_TEST.txt",
    "FINAL_SAAS_DEPLOY_TEST.txt",
    "deploy-test.txt",
    "get(__FILE__)",
    "getKeyType()",
    "origin)"
  ],
  "excluded_runtime_paths": [
    ".env",
    ".env.*",
    "storage/**",
    "bootstrap/cache/**",
    "vendor/**",
    "node_modules/**",
    "public/build/**",
    "**/*.log",
    ".phpunit.result.cache"
  ],
  "required_clean_state": {
    "no_unresolved_merge": true,
    "no_pre_staged_changes": true,
    "tracked_excluded_paths_must_be_clean": true,
    "unknown_untracked_files": "block"
  },
  "migration_policy": {
