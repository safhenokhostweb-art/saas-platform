      "database/migrations/**"
    ],
    "review_required_patterns": [
      "dropColumn\\s*\\(",
      "dropIfExists\\s*\\(",
      "Schema::drop\\s*\\(",
      "->change\\s*\\(",
      "DB::statement\\s*\\("
    ],
