# Extension E2E fixture output (materialized by e2e:seed-canvas-fixtures —
# a guarded, local/testing-only command; the physical files it writes are
# generated runtime output, never a real product's committed source asset)
/public/vendor/e2etest/
/public/vendor/acme/
/public/vendor/foo/

# Playwright E2E output
/test-results/
/playwright-report/
/tests/browser/__screenshots__/
/tests/browser/fixtures/e2e-fixtures.json
vendor.zip
deploy.zip
