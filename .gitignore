# Runtime artifacts
dump.rdb
META-INF/

# Personal isolated-cert-DB PHPUnit config (never shared, points at a
# machine-local dedicated test database) — never tracked.
phpunit.cert.xml

# Local experimental/test scripts that may contain API keys
test_gapgpt.py
test_*_local.py

# Machine-local agent settings (per-developer tool permissions/allowlists).
# Never shared: committing it exports one engineer's local policy to the team.
.claude/settings.local.json

# Gradle/AGP build output. problems-report.html in particular is a GENERATED
# diagnostic, not a synchronized asset — it changes on every build, so
# tracking it produces meaningless diffs and hides real regressions behind
# tool noise.
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/

# Upstream vendor theme sources, downloaded locally ONLY as a visual-diff
# reference during FoodMart / SleepShiman implementation. ~70 MB of
# third-party code that must never enter this repository's history.
_reference-themes/

# Machine-local tool scratch state (project identity for an external
# assistant tool). Nothing reproducible lives here.
.freebuff/

# Transient session reports. These are regenerated per verification run and
# are NOT canonical project documentation; project state belongs in
# docs/project-memory/ per AGENTS.md documentation ownership.
VALIDATION_REPORT.md
DEPLOYMENT_ARTIFACT_REPORT.md

# Temporary/local development files
cline_rules_backup/
memory-bank/
routes_snapshot.txt
debug.txt
composer_error.txt
composer_output.txt
.vite/

# Stray empty file produced by a shell/tool mishap
/Continue

# Stray root files: shell-redirect mishaps (`> count()`, `> origin)`, `> echo`),
# ad-hoc debug/restore scripts and deployment test notes. Root-anchored only.
/*(*
/*)*
/echo
/write.php
/_writer.php
/_debug_*.php
/_check_*.php
/artifact-*.txt
/deploy-test.txt
/deployment-test.txt
/DEPLOY_TEST.txt
/FINAL_*TEST*.txt

# Release descriptors live in .git/deployment/releases (policy metadata.local_directory).
# Committing one advanced the production branch and superseded the real Release on the Hub.
/.deployment/releases/*.json
