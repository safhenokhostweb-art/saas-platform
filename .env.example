APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# منطقهٔ زمانی (مثلاً Asia/Tehran برای ایران)
# APP_TIMEZONE=Asia/Tehran

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# درگاه پرداخت (fallback وقتی از پنل تنظیم نشده)
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
IDPAY_API_KEY=
IDPAY_SANDBOX=true

# دامنهٔ callback بانک (مثلاً https://safhenokhost.ir). اگر تنظیم شود، بانک کاربر را به این آدرس برمی‌گرداند.
# PAYMENT_CALLBACK_URL=https://safhenokhost.ir

# CORS برای API محصولات: خالی یا * = همهٔ دامنه‌ها. در production می‌توانید دامنهٔ سایت مالک را بنویسید.
# CORS_ORIGINS=*

# کپچا (hCaptcha)
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
AUTH_CAPTCHA_SKIP_IN_LOCAL=true

# پیامک هشدار انقضا (ملی‌پیامک یا سرویس مشابه)
SMS_PROVIDER=meli_payamak
SMS_MELI_USERNAME=
SMS_MELI_PASSWORD=
SMS_MELI_FROM=
# قالب اختیاری (متغیرها: {platform_name} {site_title} {type_fa} {date_fa} {days_left})
# SMS_TEMPLATE_EXPIRY=[{platform_name}] هشدار انقضای {type_fa} برای سایت {site_title}. تاریخ: {date_fa} ({days_left} روز مانده). لطفاً تمدید کنید.
