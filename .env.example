# ═══════════════════════════════════════════════════════════════
#  SaaS Platform — Production .env Template
#  Copy this file to .env on the server, then fill in all values.
#  Run: php artisan key:generate
#  Run: php artisan migrate --force
# ═══════════════════════════════════════════════════════════════

APP_NAME="Safhe Nokhost"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panel.safhenokhost.ir
APP_TIMEZONE=Asia/Tehran

PLATFORM_URL=https://panel.safhenokhost.ir
MODULE_ADVERTISEMENTS_ENABLED=true
PLATFORM_CONFIG_CACHE_TTL=300

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── HTTPS / Security ────────────────────────────────────────────
# اجرای HSTS (Strict-Transport-Security) توسط app/Http/Middleware/SecurityHeaders.php.
# روی پروداکشن پشت HTTPS واقعی حتماً true کنید. در local/staging بدون HTTPS خاموش بگذارید.
FORCE_HTTPS=true

# ── Audit Log Pruning ───────────────────────────────────────────
# حالت ایمن برای هرس (prune) لاگ‌های activity_logs — وقتی true باشد
# app/Console/Commands/PruneActivityLogs.php فقط تعداد ردیف‌های قابل‌حذف را
# گزارش می‌دهد و چیزی را واقعاً حذف نمی‌کند. یک بار با true اجرا/تأیید کنید،
# سپس برای هرس واقعی روی پروداکشن به false تغییر دهید.
AUDIT_PRUNE_DRY_RUN=false

# ── Database ────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_platform
DB_USERNAME=saas_user
DB_PASSWORD=

# ── Cache / Queue / Session ─────────────────────────────────────
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ── Redis ───────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Redis named cache stores (DB2–DB8 — see config/database.php)
# REDIS_SESSION_DB=2
# REDIS_RATE_LIMIT_DB=3
# REDIS_USERS_CACHE_DB=4
# REDIS_CUSTOMERS_CACHE_DB=5
# REDIS_THEMES_CACHE_DB=6
# REDIS_TICKETS_CACHE_DB=7
# REDIS_MODULES_CACHE_DB=8

# ── Reverb (WebSocket) ──────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=panel.safhenokhost.ir
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Mail ────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@safhenokhost.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS ────────────────────────────────────────────────────────
# دامنه‌های مجاز برای CORS — دامنهٔ customer-site را اینجا بگذارید
CORS_ALLOWED_ORIGINS=https://safhenokhost.ir

# ── Sanctum (SPA Authentication) ────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=panel.safhenokhost.ir,safhenokhost.ir

# ── Customer-Site Integration (Theme Purchase Provisioning) ─────
# رمز مشترک بین saas-platform و customer-site برای فراخوانی داخلی
# POST /builder/api/theme/provision هنگام خرید تم (app/Observers/ThemePurchaseOrderObserver.php).
# customer-site این هدر را با X-Provision-Secret مقایسه می‌کند
# (app/Http/Middleware/ProvisionSecretMiddleware.php) و اگر خالی باشد
# همهٔ درخواست‌های provisioning را رد می‌کند (fail-closed) — یعنی خالی
# گذاشتن این مقدار، ویژگی را غیرفعال می‌کند، نه ناامن.
#
# الزامی: باید دقیقاً همین مقدار (یک رشتهٔ تصادفی و طولانی، مثلاً با
# `php artisan tinker --execute="echo Str::random(64);"` ساخته شود) در
# .env هر دو مخزن (saas-platform و customer-site) ست شود. مقدار واقعی را
# اینجا commit نکنید؛ فقط در .env واقعی هر سرور، جداگانه مدیریت شود.
CUSTOMER_PROVISION_SECRET=

# ── کپچا (hCaptcha) ─────────────────────────────────────────────
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=
AUTH_CAPTCHA_SKIP_IN_LOCAL=false

# ── SMS ─────────────────────────────────────────────────────────
SMS_PROVIDER=meli_payamak
SMS_MELI_USERNAME=
SMS_MELI_PASSWORD=
SMS_MELI_FROM=
# پیامک Failover (kavenegar یا ghasedak)
# SMS_FAILOVER_PROVIDER=kavenegar
# SMS_KAVENEGAR_API_KEY=
# SMS_GHASEDAK_API_KEY=
# SMS_GHASEDAK_LINE=

# ── درگاه پرداخت ────────────────────────────────────────────────
PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
IDPAY_API_KEY=
IDPAY_SANDBOX=false
# دامنهٔ callback پرداخت — URL کامل سرور را وارد کنید
PAYMENT_CALLBACK_URL=https://panel.safhenokhost.ir

# ── Storage ─────────────────────────────────────────────────────
# برای VPS تک‌سروری: local/public — برای S3/MinIO/Arvan مقادیر مربوطه را پر کنید.
# MEDIA_DISK نام کانونیک است و در صورت تنظیم بر UPLOAD_DISK اولویت دارد
# (خالی = بدون تغییر رفتار فعلی). مقادیر مجاز: public | uploads | arvan | s3 | minio
MEDIA_DISK=
MEDIA_PRIVATE_DISK=
UPLOAD_DISK=public
EXPORT_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ir-thr-fr1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# MINIO_ENDPOINT=https://s3.ir-thr-fr1.arvanstorage.ir

# ArvanCloud Object Storage (arvan_backup already used for DB backups;
# arvan/arvan_private media disks activate once MEDIA_DISK=arvan)
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
ARVAN_REGION=ir-thr-at1
ARVAN_BUCKET=
ARVAN_ENDPOINT=
ARVAN_URL=
ARVAN_MEDIA_BUCKET=
ARVAN_MEDIA_PREFIX=media
ARVAN_MEDIA_PRIVATE_PREFIX=media-private
ARVAN_MEDIA_URL=

# ── هوش مصنوعی ──────────────────────────────────────────────────
# EDUCATION_AI_PROVIDER=claude   (claude | openai | null)
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
EDUCATION_AI_QUOTA_ENABLED=false
EDUCATION_AI_QUOTA_DEFAULT_DAILY=50

# ── Mobile Push ─────────────────────────────────────────────────
MOBILE_FCM_SERVER_KEY=
MOBILE_FCM_PROJECT_ID=

# ── Pusher (اگر از Reverb استفاده می‌کنید نیازی نیست) ────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1
VITE_APP_URL="${APP_URL}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
