* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Deploy scripts: force native line endings per platform
*.sh  text eol=lf
*.bat text eol=crlf

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Runtime state must never enter source-derived release artifacts.
/storage/backups export-ignore
/storage/installed.lock export-ignore
/public/uploads export-ignore
