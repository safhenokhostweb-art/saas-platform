{
  "version": "1.1.0",
  "description": "Mandatory CI checks that must pass before any merge to protected branches",
  "phase": "8.3c",
  "repositories": {
    "saas-platform": {
      "protected_branches": ["main", "develop"],
      "required_checks": [
        {
          "name": "Lint & Security Audit",
          "workflow": "php-tests.yml",
          "job": "lint",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Platform Feature Tests (MySQL 8.0)",
          "workflow": "php-tests.yml",
          "job": "platform-tests",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Education AI Provider Tests",
          "workflow": "php-tests.yml",
          "job": "edu-ai-tests",
          "blocking": true,
          "severity": "HIGH"
        },
        {
          "name": "Static Blade Analysis (fast)",
          "workflow": "frontend-governance.yml",
          "job": "static-blade-analysis",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Component Authority",
          "workflow": "frontend-governance.yml",
          "job": "component-authority",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Responsive Governance",
          "workflow": "frontend-governance.yml",
          "job": "responsive-governance",
          "blocking": true,
          "severity": "HIGH"
        },
        {
          "name": "Enterprise Frontend Governance (≥95)",
          "workflow": "frontend-governance.yml",
          "job": "enterprise-governance",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Frontend Parity (Zero Drift)",
          "workflow": "frontend-governance.yml",
          "job": "frontend-parity",
          "blocking": true,
          "severity": "HIGH"
        }
      ],
      "bypass_policy": {
        "admins_exempt": false,
        "exception_environment": "governance-exception",
        "exception_requires_approval": true
      }
    },
    "customer-site": {
      "protected_branches": ["main", "master", "develop"],
      "required_checks": [
        {
          "name": "Lint & Security Audit",
          "workflow": "php-tests.yml",
          "job": "lint",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Feature Tests (MySQL 8.0)",
          "workflow": "php-tests.yml",
          "job": "feature-tests",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Static Blade Analysis (fast)",
          "workflow": "frontend-governance.yml",
          "job": "static-blade-analysis",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Component Authority",
          "workflow": "frontend-governance.yml",
          "job": "component-authority",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Responsive Governance",
          "workflow": "frontend-governance.yml",
          "job": "responsive-governance",
          "blocking": true,
          "severity": "HIGH"
        },
        {
          "name": "Enterprise Frontend Governance (≥95)",
          "workflow": "frontend-governance.yml",
          "job": "enterprise-governance",
          "blocking": true,
          "severity": "CRITICAL"
        },
        {
          "name": "Frontend Parity (Zero Drift)",
          "workflow": "frontend-governance.yml",
          "job": "frontend-parity",
          "blocking": true,
          "severity": "HIGH"
        }
      ],
      "bypass_policy": {
        "admins_exempt": false,
        "exception_environment": "governance-exception",
        "exception_requires_approval": true
      }
    }
  },
  "global_policy": {
    "force_push_allowed": false,
    "deletions_allowed": false,
    "require_pr_before_merge": true,
    "require_conversation_resolution": true,
    "dismiss_stale_reviews": true,
    "require_up_to_date_branch": true
  }
}
